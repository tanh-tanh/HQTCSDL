{
  "name": "footage-orbit",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Immersive 3D archive interface (RING / CORRIDOR / CONSTELLATION) for the footage FastAPI app",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "tsc --noEmit && vite build && node scripts/copy-fonts.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "three": "0.187.0"
  },
  "devDependencies": {
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@fontsource/noto-serif-display": "5.3.0",
    "@fontsource/source-serif-4": "5.3.1",
    "@types/three": "0.187.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
