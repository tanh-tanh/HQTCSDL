# Copy to .env.  Values with spaces or backslashes need quotes.

# SQL Server instance.  Empty ARCHIVE_DB_LOGIN = Windows authentication (Express default).
ARCHIVE_DB_SERVER='.\SQLEXPRESS'
ARCHIVE_DB_NAME=video_archive
ARCHIVE_DB_DRIVER='ODBC Driver 18 for SQL Server'
# ARCHIVE_DB_LOGIN=sa
# ARCHIVE_DB_PASSWORD=...

# Release files (frames.csv, ocr.sqlite, asr.sqlite) and unpacked keyframes.
ARCHIVE_DATA_DIR=./data/archive
ARCHIVE_KEYFRAMES_DIR=./data/archive/keyframes

# Visual channel (SigLIP2 on CPU).  ARCHIVE_VISUAL=0 for text-only search.
ARCHIVE_VISUAL=1
ARCHIVE_SIGLIP_MODEL=./models/siglip2-so400m-patch16-384
ARCHIVE_SIGLIP_INDEX=./data/archive/siglip2_L23.faiss

# Cancel a search after this many seconds.
ARCHIVE_SEARCH_TIMEOUT=30
# Set to 1 when the site is served over HTTPS.
ARCHIVE_SECURE_COOKIES=0
